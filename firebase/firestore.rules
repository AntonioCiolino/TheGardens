rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared nursery workspace — any signed-in Google user can read/write.
    // Tighten later with: request.auth.token.email.matches('.*@yourdomain[.]com$')
    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
